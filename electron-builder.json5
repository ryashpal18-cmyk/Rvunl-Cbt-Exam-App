{
  appId: "in.rvunl.cbtmock",
  productName: "RVUNL CBT Mock Exam",
  directories: {
    output: "release"
  },
  files: [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  asar: true,
  publish: [
    {
      provider: "github",
      owner: "ryashpal18-cmyk",
      repo: "Rvunl-Cbt-Exam-App",
      releaseType: "draft"
    }
  ],
  win: {
    icon: "build/icon.png",
    target: [
      { target: "nsis", arch: ["x64"] },
      { target: "portable", arch: ["x64"] }
    ]
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "RVUNL CBT Mock Exam"
  }
}
