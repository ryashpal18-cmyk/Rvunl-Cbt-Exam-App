{
  "name": "rvunl-cbt-exam-app",
  "version": "1.1.0",
  "private": true,
  "description": "Offline RVUNL Junior Assistant Phase-I CBT mock exam desktop app",
  "author": "RVUNL CBT Exam App",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:electron && npm run build:web",
    "package:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "read-excel-file": "^9.3.17",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "^6.4.6",
    "wait-on": "8.0.1"
  }
}
